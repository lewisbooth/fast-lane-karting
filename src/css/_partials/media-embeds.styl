.media-embed
  width 100%
  margin-bottom 2rem

  &__stage
    height 600px
    background #191919
    color white
    overflow hidden

  &--map &__stage
    height 450px
    background #E5E3DF
    color #171717

  &__placeholder
    height 100%
    display flex
    flex-direction column
    align-items center
    justify-content center
    gap 1rem
    padding 2rem
    text-align center

    p
      margin 0

  &__load
    border 0
    border-radius 0
    background #BB2024
    color white
    min-height 44px
    padding .75rem 1.5rem
    font inherit
    font-weight bold
    cursor pointer

    &:hover
      background #94191D

    &:focus-visible
      outline 3px solid #F9CE4C
      outline-offset 3px

    &[hidden]
      display none

  &__stage iframe
    display block
    width 100%
    height 100%
    border 0

  &__direct
    display inline-flex
    align-items center
    min-height 44px
    color white
    text-decoration underline

    &:focus-visible
      outline 3px solid #F9CE4C
      outline-offset 3px

.media-video
  position relative
  width 100%
  aspect-ratio 16 / 9
  background black
  margin-bottom 5rem

  &__trigger
    position absolute
    inset 0
    display flex
    align-items center
    justify-content center
    color white

    &:focus-visible
      outline 3px solid #F9CE4C
      outline-offset 3px

  &__poster
    position absolute
    inset 0

    img
      width 100%
      height 100%
      object-fit cover

  &__play
    position relative
    display inline-flex
    align-items center
    justify-content center
    min-height 44px
    padding .75rem 1.5rem
    background #BB2024
    color white
    font-weight bold

  video
    display block
    width 100%
    height 100%
    background black

  &__direct
    position absolute
    top 100%
    left 0
    display inline-flex
    align-items center
    min-height 44px
    color white
    text-decoration underline

    &:focus-visible
      outline 3px solid #F9CE4C
      outline-offset 3px
