mixin newsletter
  section.newsletter
    .container
      h2 Sign up to receive the latest news, offers and discounts
      form(name='newsletter')
        label.visually-hidden(for='newsletter-email') Email address
        input.no-margin#newsletter-email(type='email' name='email' autocomplete='email' placeholder='Your email...' required)
        button.button__primary(type='submit') Sign Up
