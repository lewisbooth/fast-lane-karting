mixin amp
  section.amp
    .container
      - const year = new Date().getFullYear()
      p.no-margin &copy; #{year} Fast Lane Karting Limited
      a(href='https://amp.studio' target='_blank' rel='noopener' aria-label='Website by AMP Studio')
        p.no-margin.hide-mobile Website by
        img(src='/images/logos/amp-logo.svg' alt='AMP Studio' width='111' height='31')
