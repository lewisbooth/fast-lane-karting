extends _partials/layout

block pageScripts
  script(type="module" src="/js/header-video.js")

block content
  .header-video
    picture.header-video__poster
      source(media="(max-width: 500px)" srcset="/video/fast-lane-karting-header-poster-small.webp" type="image/webp")
      source(media="(max-width: 767px)" srcset="/video/fast-lane-karting-header-poster-mobile.webp" type="image/webp")
      img(src="/video/fast-lane-karting-header-poster-laptop.webp" srcset="/video/fast-lane-karting-header-poster-laptop.webp 1366w, /video/fast-lane-karting-header-poster-hd.webp 1920w" sizes="100vw" alt="" width="1366" height="405" fetchpriority="high")
    video(src="/video/fast-lane-karting-header.mp4" preload="none" loop muted playsinline width="1920" height="1080" aria-label="Karting at Fast Lane Karting")
    .header-video__controls
      .container
        button.header-video__controls--play-pause(type='button' aria-label='Play video')
          img(id='play' src='/images/video-controls/play.svg' alt='' width='65' height='65')
          img(id='pause' src='/images/video-controls/pause.svg' alt='' width='65' height='65')
        .header-video__controls--right
          button.header-video__controls--right--audio(type='button' aria-label='Unmute video')
            img(id='muted' src='/images/video-controls/muted.svg' alt='' width='54' height='54')
            img(id='unmuted' src='/images/video-controls/unmuted.svg' alt='' width='52' height='52')
          button.header-video__controls--right--fullscreen(type='button' aria-label='View video fullscreen')
            img(id='fullscreen' src='/images/video-controls/fullscreen.svg' alt='' width='102' height='75')
    p.header-video__status.visually-hidden(role='status')
  .header-video__refurb(href="/layout" target="_blank")
    .container 
      a(href="/layout" target="_blank") We have now undergone a multilevel track refurbishment. Please click here to view.

  section.black.main-title
    .container
      h1.center The midlands' #[span.red premiere] indoor karting experience
      //- h2.center Specialists in Corporate Entertainment and Hospitality
      div
        a.button.button__primary(href='https://fastlane.bookmykarting.co.uk/book/385/booking.aspx') Book Online
        a.button.button__grey(href='/race-packages') Race Packages

  section.grey.category-cards
    .container
      .category-cards__card
        .category-cards__card--image
          img(src='/images/home-categories/race-packages.webp' alt='Race Packages' width='377' height='208' loading='eager' fetchpriority='high' decoding='async')
        .category-cards__card--text
          h2 Race Packages
          .red-highlight
          p The perfect choice for team building, stag/hen parties and group events! Pit your skill and endurance against each other with our selection of Grand Prix and Endurance race packages. Racing times range from 30 to 150 minutes with food provided on-site.
          a.button.button__primary(href='/race-packages' aria-label='View race packages and book online') Book Online
      .category-cards__card
        .category-cards__card--image
          img(src='/images/home-categories/arrive-and-drive.webp' alt='Arrive & Drive' width='377' height='208' loading='lazy' decoding='async')
        .category-cards__card--text
          h2 Arrive & Drive
          .red-highlight
          p There's no need to book for small groups - turn up at any time and drive for up to 100 laps! Drivers aged 12 years or older are welcome anytime as long as the track is available. High performance 200cc karts are available for ages 14 and over.
          a.button.button__primary(href='/arrive-and-drive' aria-label='View Arrive and Drive and book online') Book Online
      .category-cards__card
        .category-cards__card--image
          img(src='/images/home-categories/juniors-and-parties.webp' alt='Juniors & Parties' width='377' height='208' loading='lazy' decoding='async')
        .category-cards__card--text
          h2 Juniors & Parties
          .red-highlight
          p Go-karting makes a great birthday party or family event for up to 8 people. Our junior packages include up to one hour of track time per driver, a hot meal and drinks in our private corporate lounge overlooking the track, plus medals and a trophy for the birthday host.
          a.button.button__primary(href='/juniors-and-parties' aria-label='View junior karting and party packages and book online') Book Online
          
  section.black.corporate-events
    .container.center
      h2 Corporate & Group Events
      .red-highlight.centered
      p Corporate Hospitality at it’s finest.
      p When looking to book your next Event, look no further. Hosting your Corporate or Group Event at Fast Lane Karting will ensure a safe, friendly and exhilarating night's racing with on-site catering and Corporate Lounge.
      p.bold Run by professional people who care.
      a.button.button__primary(href='/corporate-events') View Prices

