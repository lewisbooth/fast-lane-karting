extends _partials/layout

block nav
  +navigation('/offers')

block title
  title Spooktober Offers | Fast Lane Go Karting Stoke

block description
  meta(name="description" content="Spooktober karting offers at Fast Lane, Stoke-on-Trent, available 23 October - 2 November. Save 10% on selected sessions or get 25% extra laps. Book online or call 01782 250 450.")

block socialImage
  meta(property="og:image" content="/images/banners/happy-halloween.jpg")
  meta(property="og:image:type" content="image/jpeg")
  meta(property="og:image:width" content="3365")
  meta(property="og:image:height" content="1245")
  meta(property="og:image:alt" content="Happy Halloween artwork with the Fast Lane Karting logo and pumpkins")

block dealSticker

