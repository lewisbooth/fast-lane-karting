extends _partials/layout

block nav
  +navigation('/layout')

block title
  title Track Layout | Fast Lane Go Karting Stoke

block description
  meta(name="description" content="The best indoor go karting venue in Stoke-on-Trent for 25 years. High performance Sodi SR4 sprint karts, kids karts and on-site catering. Arrive & Drive today!")

block content
  section.black.track
    .container
      h1.center Track Layout
      .red-highlight.centered
      .race-packages__price-list
        .content-block
          h2 The Midlands' Best Karting Track
          .red-highlight
          p Experience the exhilarating rush of driving on the Midlands’ best karting circuit! The track has been completely overhauled and we now have a New Multi Level Circuit with super smooth ramps for a seamless transition between levels. We've kept it fast, flowing, and even thrown in a few little technical bits to test the skills of even the best drivers. Competition for the outright fastest lap will be fierce.
          p Adults get to drive our powerful 200cc Sodi SR4 karts for high-octane thrills and competition. For the younger drivers, our new Junior Racer karts are the perfect choice to hone their skills before progressing up to the adult category.
          p Our on-site kitchen provides food and drinks throughout the day, and our corporate lounge overlooking the track is perfect for parties looking for a VIP experience.
          p Think you’ve got what it takes to be the best? Have a go at our fastest lap and claim the top of the leaderboard for yourself!

          .red-strip All-time fastest lap
          .fastest-lap
            span.fastest-lap__lap-time= fastestLap.lapTime
            span.fastest-lap__name= fastestLap.name
          p.fastest-lap__status(hidden)
          
        a.track__image(href='/images/track-layout/track-layout-2021.jpg' target='_blank' rel='noopener noreferrer' data-no-instant aria-label='Open the full-size track diagram in a new tab')
          picture
            source(media='(max-width: 767px)' type='image/avif' srcset='/images/track-layout/track-layout-2021-small.avif')
            source(type='image/avif' srcset='/images/track-layout/track-layout-2021-small.avif 384w, /images/track-layout/track-layout-2021-medium.avif 640w, /images/track-layout/track-layout-2021-large.avif 960w' sizes='(max-width: 767px) 85vw, (max-width: 1023px) 76vw, 45vw')
            img(src='/images/track-layout/track-layout-2021.webp' alt='Diagram of the top and bottom track levels, ramps, pit lane and race flags' width='960' height='1436' fetchpriority='high')

      h2.center 3D Track Tour
      .red-highlight.centered
      .media-embed.media-embed--tour(data-embed-src='https://my.360picture.uk/tour/fastlane-karting' data-embed-title='3D tour of the Fast Lane Karting track')
        .media-embed__stage
          .media-embed__placeholder
            p Explore the track in the interactive 3D tour.
            button.media-embed__load(type='button' hidden) Load 3D track tour
        a.media-embed__direct(href='https://my.360picture.uk/tour/fastlane-karting' target='_blank' rel='noopener noreferrer') Open the 3D track tour in a new tab

      h2.center Onboard Video
      .red-highlight.centered
      .media-video(data-video-src='/video/track-layout.mp4')
        a.media-video__trigger(href='/video/track-layout.mp4' aria-label='Play onboard video of the Fast Lane Karting track' data-no-instant)
          picture.media-video__poster
            source(type='image/avif' srcset='/video/track-layout-poster-small.avif 480w, /video/track-layout-poster-medium.avif 720w, /video/track-layout-poster-large.avif 1200w' sizes='(min-width: 1280px) 1200px, 95vw')
            img(src='/video/track-layout-poster.webp' alt='' width='1280' height='720' loading='lazy' decoding='async')
          span.media-video__play Play onboard video
        a.media-video__direct(href='/video/track-layout.mp4' target='_blank' rel='noopener noreferrer' data-no-instant) Open onboard video directly
