extends _partials/layout

block nav
  +navigation('/live-timing')

block title
  title Live Race Timing | Fast Lane Go Karting Stoke

block description
  meta(name="description" content="View lap times live on our website. Call 01782 250 450 or email enquiries@fastlanekarting.co.uk to book a karting package. We're open from 10am until 10:30pm, 7 days a week.")

block content
  section.black
    .container
      h1.center Live Race Timing
      .red-highlight.centered
      .media-embed.media-embed--timing(data-embed-src='https://flkstaffordshire.clubspeedtiming.com/cs-speedscreen/#/3' data-embed-title='Live lap timing at Fast Lane Karting')
        .media-embed__stage
          .media-embed__placeholder
            p View live lap times from the track.
            button.media-embed__load(type='button' hidden) Load live timing
        a.media-embed__direct(href='https://flkstaffordshire.clubspeedtiming.com/cs-speedscreen/#/3' target='_blank' rel='noopener noreferrer') Open live timing in a new tab
