extends _partials/layout

block nav
  +navigation('/contact')

block title
  title  Contact Us | Fast Lane Go Karting Stoke
  
block description
  meta(name="description" content="Call 01782 250 450 or email enquiries@fastlanekarting.co.uk to book a karting package. We're open from 10am until 10:30pm, 7 days a week. Find us at 151 King Street, Stoke-on-Trent, ST4 3ER.")

block content
  section.grey.contact
    .container
      .content-block
        div
          h1.contact__heading Contact Us
          .red-highlight
          h2.contact__label Call Us
          p 01782 250 450
          h2.contact__label Email Us
          p enquiries@fastlanekarting.co.uk
          a.button.button__primary(href='https://fastlane.bookmykarting.co.uk/book/385/booking.aspx' target='_blank') Book Online
          h2.contact__label Social Media
          .contact__social
            a(href='https://www.facebook.com/fastlanekartingindoor' target='_blank')
              img(src='/images/social-media/facebook.svg' alt='Facebook' width='40' height='40')
            a(href='https://www.instagram.com/fastlanekarting_stoke/' target='_blank')
              img(src='/images/social-media/instagram.svg' alt='Instagram' width='40' height='40')
        div
          h2.section-heading Opening Hours
          .red-highlight
          ul
            li 
              span Monday
              span 10:00am - 10:30pm
            li 
              span Tuesday
              span 10:00am - 10:30pm
            li 
              span Wednesday
              span 10:00am - 10:30pm
            li 
              span Thursday
              span 10:00am - 10:30pm
            li 
              span Friday
              span 10:00am - 10:30pm
            li 
              span Saturday
              span 9:00am - 10:30pm
            li 
              span Sunday
              span 10:00am - 10:30pm
      

  .media-embed.media-embed--map(data-embed-src='https://www.google.com/maps/embed/v1/place?q=place_id:ChIJp3iP_LxpekgRJhrb65GE7V0&key=AIzaSyDy2rP4t2jzZ5Gj5dI83xCgi6DY6hzO-Ss' data-embed-title='Map showing Fast Lane Karting at 151 King Street, Stoke-on-Trent')
    .media-embed__stage
      .media-embed__placeholder
        p Find us at 151 King Street, Stoke-on-Trent, ST4 3ER.
        button.media-embed__load(type='button' hidden) Load interactive map
    a.media-embed__direct(href='https://www.google.com/maps/search/?api=1&query=Fast+Lane+Karting&query_place_id=ChIJp3iP_LxpekgRJhrb65GE7V0' target='_blank' rel='noopener noreferrer') Open the map in a new tab
