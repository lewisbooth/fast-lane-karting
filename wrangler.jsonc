{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fast-lane-karting",
  "main": "src/worker/index.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/layout",
      "/layout/",
      "/layout.html",
      "/admin/lap-record",
      "/admin/lap-record/"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "NEWSLETTER_TRANSPORT": "mailchimp",
    "MAILCHIMP_AUDIENCE_ID": "eeb6393074",
    "MAILCHIMP_OPT_IN": "single",
    "NEWSLETTER_FROM": "",
    "NEWSLETTER_TO": "lewis@amp.studio"
  },
  "secrets": {
    "required": [
      "MAILCHIMP_API_KEY",
      "LAP_RECORD_PASSWORD"
    ]
  },
  "ratelimits": [
    {
      "name": "NEWSLETTER_RATE_LIMITER",
      "namespace_id": "731650726411001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "LAP_RECORD_RATE_LIMITER",
      "namespace_id": "731650726411003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "name": "fast-lane-karting-mailchimp-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "NEWSLETTER_TRANSPORT": "mailchimp",
        "MAILCHIMP_AUDIENCE_ID": "eeb6393074",
        "MAILCHIMP_OPT_IN": "single",
        "NEWSLETTER_FROM": "",
        "NEWSLETTER_TO": "lewis@amp.studio"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": [
          "/api/*",
          "/layout",
          "/layout/",
          "/layout.html",
          "/admin/lap-record",
          "/admin/lap-record/"
        ]
      },
      "secrets": {
        "required": [
          "MAILCHIMP_API_KEY",
          "LAP_RECORD_PASSWORD"
        ]
      },
      "ratelimits": [
        {
          "name": "NEWSLETTER_RATE_LIMITER",
          "namespace_id": "731650726411002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "LAP_RECORD_RATE_LIMITER",
          "namespace_id": "731650726411004",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "kv_namespaces": [
        {
          "binding": "LAP_RECORDS",
          "id": "868aca5ff7cb49bdb1927fa2d142ead4"
        }
      ]
    }
  },
  "kv_namespaces": [
    {
      "binding": "LAP_RECORDS",
      "id": "aa6f6dbaa9d14c059d5a1be7b7b2f4d3"
    }
  ]
}
