{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fast-lane-karting",
  "main": "src/worker/index.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "NEWSLETTER_TRANSPORT": "legacy",
    "NEWSLETTER_FROM": "",
    "NEWSLETTER_TO": "lewis@amp.studio"
  },
  "secrets": {
    "required": [
      "LEGACY_NEWSLETTER_API_KEY"
    ]
  }
}
